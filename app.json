{
  "expo": {
    "name": "Amharic Bible",
    "slug": "amharic-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bible.amharic.classic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3E9"
      },
      "package": "com.bible.amharic.classic"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-asset"
    ]
  }
}
